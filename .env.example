# === Yandex Cloud (обязательно — без ключей робот не говорит и не слышит) ===
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# === SaluteSpeech (опционально, альтернативный голос) ===
SALUTESPEECH_AUTH_KEY=

# === fish.audio (опционально, свои голоса — TTS через reference_id) ===
FISHAUDIO_API_KEY=
# reference_id голоса по умолчанию (можно оставить пустым и выбирать в админке)
FISHAUDIO_MODEL=

# === Приложение ===
APP_ENV=production
LOG_LEVEL=INFO
MAX_CONCURRENT_CALLS=3

# === PostgreSQL (база клиентов и состояние обзвона) ===
# ai-robot работает в host-режиме сети (для SIP/RTP), поэтому обращается к БД
# по 127.0.0.1 (postgres публикует порт на localhost хоста).
DATABASE_URL=postgresql+asyncpg://robot:robot@127.0.0.1:5432/airobot

# === SIP-регистрация робота как экстеншена на АТС заказчика (через VPN) ===
# Бэкенд телефонии: pjsua2 (устойчивый, по умолчанию) | pyvoip (лёгкий, запасной)
SIP_BACKEND=pjsua2
SIP_SERVER=192.168.0.110
SIP_EXTENSION=
SIP_PASSWORD=
SIP_CONTEXT=
SIP_CODEC=pcma
# Подробный лог SIP-сообщений pyVoIP (включать только для диагностики)
SIP_DEBUG=false

# === HTTP-API res24.php (инициирование звонка + статус/CDR) ===
RES24_BASE_URL=http://192.168.0.110
RES24_LOGIN=robott
RES24_SECRET=
# Экстеншен робота, который подставляется в параметр from при res24 call
ROBOT_EXTENSION=

# === AMI (опционально) ===
AMI_HOST=192.168.0.110
AMI_PORT=5038
AMI_USER=robott
AMI_SECRET=

# === Набор номеров и лимиты транков ===
# Национальный префикс для res24 `to` (8 или 7)
DIAL_NATIONAL_PREFIX=8
# t2 (SIP-GSM) — 1 линия; местные через «Телезон» — до 30
ROUTE_LIMIT_T2=1
ROUTE_LIMIT_LOCAL=30

# === Диалер ===
DIALER_ENABLED=false
DIALER_POLL_INTERVAL=5.0
MAX_RETRIES=3
RETRY_BACKOFF_BASE=300.0

# === Антиспам-темп набора (дефолты; правятся из админки → вкладка «Диалер») ===
# Мин. пауза между наборами на маршруте (сек); >0 → набор по одному за раз. 0 = без паузы
DIAL_MIN_INTERVAL_SEC=12.0
# Случайный разброс к паузе, 0..jitter (сек)
DIAL_JITTER_SEC=8.0
# Дневной лимит наборов на маршрут (сброс в полночь по МСК). 0 = без лимита
DIAL_DAILY_LIMIT_PER_ROUTE=0
# Cooldown на повторный набор одного номера (часов). 0 = выключено
DIAL_NUMBER_COOLDOWN_HOURS=24.0
